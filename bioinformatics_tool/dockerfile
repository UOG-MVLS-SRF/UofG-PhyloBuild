FROM python:3.11
WORKDIR ./app
COPY ./bioinformatics_tool/requirements.txt requirements.txt


RUN pip install --upgrade pip
RUN pip3 install -r requirements.txt

COPY ./bioinformatics_tool .

RUN apt-get update && apt-get install -y cron dos2unix

#deploy cron
RUN dos2unix /app/crontab && dos2unix /app/python_cron.sh
RUN chmod 777 /app/python_cron.sh
RUN cp /app/crontab /etc/cron.d/hello-cron
# Create the log file to be able to run tail
RUN touch /app/cron.log

# Give execution rights on the cron job
RUN chmod 0644 /etc/cron.d/hello-cron && chmod 0666 /app/cron.log


EXPOSE 8000